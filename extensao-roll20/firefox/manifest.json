{
  "manifest_version": 3,
  "name": "Grimório do Aventureiro - Roll20",
  "version": "1.0.0",
  "description": "Adiciona o botão Grimório ao Roll20 para importar a ficha completa gerada pelo Grimório do Aventureiro (D&D 4e).",
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/editor/*"
      ],
      "js": [
        "grimorio-roll20.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "grimorio-roll20@cramenha.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
